  "queries": {
    "tables": "SELECT c.relname,c.relkind,c.relpersistence,c.relrowsecurity,c.relforcerowsecurity\n            FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace\n            WHERE n.nspname='platform' AND c.relname=ANY(%s) ORDER BY c.relname",
    "columns": "SELECT c.relname,a.attnum,a.attname,pg_catalog.format_type(a.atttypid,a.atttypmod),\n            a.attnotnull,a.attidentity,a.attgenerated,pg_catalog.pg_get_expr(d.adbin,d.adrelid)\n            FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace\n            JOIN pg_catalog.pg_attribute a ON a.attrelid=c.oid\n            LEFT JOIN pg_catalog.pg_attrdef d ON d.adrelid=c.oid AND d.adnum=a.attnum\n            WHERE n.nspname='platform' AND c.relname=ANY(%s) AND a.attnum>0 AND NOT a.attisdropped\n            ORDER BY c.relname,a.attnum",
    "constraints": "SELECT c.relname,k.conname,k.contype,k.convalidated,k.condeferrable,k.condeferred,\n            pg_catalog.pg_get_constraintdef(k.oid,true)\n            FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace\n            JOIN pg_catalog.pg_constraint k ON k.conrelid=c.oid\n            WHERE n.nspname='platform' AND c.relname=ANY(%s) ORDER BY c.relname,k.conname",
    "indexes": "SELECT c.relname,i.indisvalid,i.indisready,pg_catalog.pg_get_indexdef(i.indexrelid)\n            FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace\n            JOIN pg_catalog.pg_index i ON i.indrelid=c.oid\n            WHERE n.nspname='platform' AND c.relname=ANY(%s) ORDER BY c.relname,pg_catalog.pg_get_indexdef(i.indexrelid)",
    "triggers": "SELECT c.relname,t.tgenabled,pg_catalog.pg_get_triggerdef(t.oid,true)\n            FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace\n            JOIN pg_catalog.pg_trigger t ON t.tgrelid=c.oid\n            WHERE n.nspname='platform' AND c.relname=ANY(%s) AND NOT t.tgisinternal\n            ORDER BY c.relname,t.tgname"
  },
