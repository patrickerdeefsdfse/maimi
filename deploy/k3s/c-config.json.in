{
  "token-file": "/etc/rancher/k3s/secrets/server-token",
  "agent-token-file": "/etc/rancher/k3s/secrets/agent-token",
  "write-kubeconfig-mode": "0600",
  "data-dir": "/data/maimi-production/k3s",
  "cluster-cidr": "{{POD_CIDR}}",
  "service-cidr": "{{SERVICE_CIDR}}",
  "cluster-dns": "{{CLUSTER_DNS}}",
  "cluster-domain": "cluster.local",
  "flannel-backend": "vxlan",
  "flannel-external-ip": false,
  "flannel-ipv6-masq": false,
  "disable": [
    "servicelb",
    "traefik",
    "local-storage"
  ],
  "disable-cloud-controller": false,
  "disable-helm-controller": false,
  "disable-network-policy": false,
  "disable-kube-proxy": false,
  "egress-selector-mode": "agent",
  "embedded-registry": false,
  "secrets-encryption": true,
  "secrets-encryption-provider": "aescbc",
  "tls-san": [
    "{{A1_IP}}",
    "{{A2_IP}}",
    "{{C_IP}}"
  ],
  "tls-san-security": true,
  "etcd-disable-snapshots": false,
  "node-name": "maimi-c",
  "node-ip": "{{C_IP}}",
  "advertise-address": "{{C_IP}}",
  "node-label": [
    "maimi-role=execution",
    "maimi-node=c"
  ],
  "kubelet-arg": [
    "kube-reserved=cpu=1000m,memory=1024Mi",
    "system-reserved=cpu=1000m,memory=1024Mi",
    "enforce-node-allocatable=pods"
  ],
  "kube-controller-manager-arg": [
    "node-cidr-mask-size-ipv4=26"
  ],
  "server": "https://{{A1_IP}}:6443"
}
