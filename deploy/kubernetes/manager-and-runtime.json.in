    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "labels": {
          "maimi.megmeet.com/environment": "production",
          "maimi.megmeet.com/release": "maimi-r96-production"
        },
        "name": "personal-cloud-manager",
        "namespace": "maimi-production"
      },
      "spec": {
        "ports": [
          {
            "name": "http",
            "port": 8092,
            "protocol": "TCP",
            "targetPort": 8092
          }
        ],
        "selector": {
          "maimi.megmeet.com/component": "personal-cloud-manager",
          "maimi.megmeet.com/environment": "production",
          "maimi.megmeet.com/pool-role": "chat"
        },
        "type": "ClusterIP"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "maimi.megmeet.com/component": "personal-cloud-manager",
          "maimi.megmeet.com/environment": "production",
          "maimi.megmeet.com/release": "maimi-r96-production"
        },
        "name": "personal-cloud-manager",
        "namespace": "maimi-production"
      },
      "spec": {
        "replicas": 2,
        "revisionHistoryLimit": 2,
        "selector": {
          "matchLabels": {
            "maimi.megmeet.com/component": "personal-cloud-manager",
            "maimi.megmeet.com/environment": "production",
            "maimi.megmeet.com/pool-role": "chat"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": 0,
            "maxUnavailable": 1
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "labels": {
              "maimi.megmeet.com/component": "personal-cloud-manager",
              "maimi.megmeet.com/environment": "production",
              "maimi.megmeet.com/pool-role": "chat"
            }
          },
          "spec": {
            "affinity": {
              "nodeAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": {
                  "nodeSelectorTerms": [
                    {
                      "matchExpressions": [
                        {
                          "key": "kubernetes.io/hostname",
                          "operator": "In",
                          "values": [
                            "maimi-a1",
                            "maimi-a2"
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              "podAntiAffinity": {
                "requiredDuringSchedulingIgnoredDuringExecution": [
                  {
                    "labelSelector": {
                      "matchLabels": {
                        "maimi.megmeet.com/component": "personal-cloud-manager",
                        "maimi.megmeet.com/environment": "production",
                        "maimi.megmeet.com/pool-role": "chat"
                      }
                    },
                    "topologyKey": "kubernetes.io/hostname"
                  }
                ]
              }
            },
            "automountServiceAccountToken": true,
            "containers": [
              {
                "command": [
                  "uvicorn",
                  "manager_entry:app",
                  "--app-dir",
                  "/opt/personal-cloud",
                  "--host",
                  "0.0.0.0",
                  "--port",
                  "8092",
                  "--no-access-log"
                ],
                "env": [
                  {
                    "name": "MAIMI_POOL_ROLE",
                    "value": "chat"
                  },
                  {
                    "name": "PERSONAL_CLOUD_CLOSED_SECONDS",
                    "value": "7200"
                  },
                  {
                    "name": "PERSONAL_CLOUD_IDLE_SECONDS",
                    "value": "120"
                  },
                  {
                    "name": "PERSONAL_CLOUD_K8S_API",
                    "value": "https://kubernetes.default.svc"
                  },
                  {
                    "name": "PERSONAL_CLOUD_K8S_CA_FILE",
                    "value": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
                  },
                  {
                    "name": "PERSONAL_CLOUD_K8S_COMPLETED_IDLE_SECONDS",
                    "value": "30"
                  },
                  {
                    "name": "PERSONAL_CLOUD_K8S_CPU_MILLIS",
                    "value": "250"
                  },
                  {
                    "name": "PERSONAL_CLOUD_K8S_EPHEMERAL_MIB",
                    "value": "512"
                  },
                  {
                    "name": "PERSONAL_CLOUD_K8S_FILES_ACCESS_MODE",
                    "value": "ReadWriteMany"
                  },
                  {
                    "name": "PERSONAL_CLOUD_K8S_FILES_GIB",
                    "value": "5"
                  },
                  {
                    "name": "PERSONAL_CLOUD_K8S_FILES_STORAGE_CLASS",
