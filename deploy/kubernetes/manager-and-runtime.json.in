    {
      "apiVersion": "v1",
      "automountServiceAccountToken": false,
      "kind": "ServiceAccount",
      "metadata": {
        "labels": {
          "maimi.megmeet.com/environment": "production",
          "maimi.megmeet.com/release": "maimi-r96-production"
