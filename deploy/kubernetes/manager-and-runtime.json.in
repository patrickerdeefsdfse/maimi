                  "-c",
                  "import hashlib,sys;f=open('/node/bin/crictl','rb');assert hashlib.file_digest(f,'sha256').hexdigest()=='3c8f814620506fa560e9737638f2190bdb1e4cd5356aaeb90b20309d88b58873';f.close();sys.path.insert(0,'/observer');import observer as o;old=o.LocalNodeReader;\nclass HostReader(old):\n def __init__(self,**kw):super().__init__(**kw,cgroup_root='/node/cgroup',boot_id_path='/node/boot_id');self.command=[self.command[0]]+self.command[2:]\no.LocalNodeReader=HostReader;o.serve_from_env()"
                ],
