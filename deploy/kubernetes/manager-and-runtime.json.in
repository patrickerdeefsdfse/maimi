                "imagePullPolicy": "Never",
                "name": "manager",
                "ports": [
                  {
                    "containerPort": 8092,
                    "name": "http"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python3",
                      "-I",
                      "-B",
                      "-c",
                      "import json,urllib.request,pathlib;t=pathlib.Path('/run/maimi/manager-token').read_text().strip();r=urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8092/v1/status',headers={'Authorization':'Bearer '+t}),timeout=3);v=json.load(r);raise SystemExit(0 if v.get('status')=='ready' else 1)"
                    ]
                  },
                  "failureThreshold": 3,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "resources": {
                  "limits": {
                    "cpu": "1000m",
                    "ephemeral-storage": "256Mi",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "ephemeral-storage": "64Mi",
                    "memory": "192Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsGroup": 1000,
                  "runAsNonRoot": true,
                  "runAsUser": 1000,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "startupProbe": {
                  "exec": {
                    "command": [
                      "python3",
                      "-I",
                      "-B",
                      "-c",
                      "import json,urllib.request,pathlib;t=pathlib.Path('/run/maimi/manager-token').read_text().strip();r=urllib.request.urlopen(urllib.request.Request('http://127.0.0.1:8092/v1/status',headers={'Authorization':'Bearer '+t}),timeout=3);v=json.load(r);raise SystemExit(0 if v.get('status')=='ready' else 1)"
                    ]
                  },
                  "failureThreshold": 30,
                  "periodSeconds": 10,
                  "timeoutSeconds": 5
                },
                "volumeMounts": [
                  {
                    "mountPath": "/etc/maimi",
                    "name": "config",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/run/maimi",
                    "name": "auth",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/run/observer",
                    "name": "observer",
                    "readOnly": true
                  },
                  {
                    "mountPath": "/tmp",
                    "name": "tmp"
                  },
                  {
                    "mountPath": "/run/maimi-db",
                    "name": "db-ca",
                    "readOnly": true
                  }
                ]
              }
            ],
            "enableServiceLinks": false,
            "securityContext": {
              "fsGroup": 1000,
              "runAsGroup": 1000,
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "serviceAccountName": "maimi-manager",
            "terminationGracePeriodSeconds": 30,
            "volumes": [
              {
                "configMap": {
                  "defaultMode": 292,
                  "name": "maimi-manager-config-r106-rc1"
                },
                "name": "config"
              },
              {
                "name": "auth",
                "secret": {
                  "defaultMode": 288,
                  "secretName": "maimi-runtime-manager-auth-r96"
                }
              },
              {
                "name": "observer",
                "secret": {
                  "defaultMode": 288,
                  "secretName": "maimi-runtime-observer-keys-r96"
                }
              },
              {
                "emptyDir": {
                  "sizeLimit": "64Mi"
                },
                "name": "tmp"
              },
              {
                "configMap": {
                  "defaultMode": 292,
                  "name": "maimi-production-db-ca"
                },
                "name": "db-ca"
              }
            ]
          }
        }
      }
