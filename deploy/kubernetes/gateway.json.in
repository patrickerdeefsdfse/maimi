                    "{{SITE_GATEWAY_ENDPOINT_6}}/24",
                    "{{SITE_GATEWAY_ENDPOINT_7}}/24",
                    "{{SITE_GATEWAY_ENDPOINT_8}}/16",
                    "198.18.0.0/15",
                    "198.51.100.0/24",
