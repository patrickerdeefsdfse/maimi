    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "gateway",
        "namespace": "maimi-production",
        "labels": {
          "maimi.megmeet.com/environment": "production",
          "app.kubernetes.io/part-of": "maimi"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "maimi.megmeet.com/component": "gateway",
            "maimi.megmeet.com/environment": "production"
          }
        },
        "policyTypes": [
          "Ingress",
          "Egress"
        ],
        "ingress": [
          {
            "from": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "maimi-production"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "maimi.megmeet.com/component": "chat-host"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "maimi-production-execution"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "maimi.megmeet.com/component": "execution-worker"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          },
          {
            "from": [
              {
                "ipBlock": {
                  "cidr": "{{A1_IP}}/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "{{A2_IP}}/32"
                }
              }
            ],
            "ports": [
              {
                "port": 8080,
                "protocol": "TCP"
              }
            ]
          }
        ],
        "egress": [
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "kube-system"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "k8s-app": "kube-dns"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 53,
                "protocol": "TCP"
              },
              {
                "port": 53,
                "protocol": "UDP"
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "{{A1_IP}}/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "{{A2_IP}}/32"
                }
              }
            ],
            "ports": [
              {
                "port": 6432,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "{{B1_IP}}/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "{{B2_IP}}/32"
                }
              }
            ],
            "ports": [
              {
                "port": 6379,
                "protocol": "TCP"
              },
              {
                "port": 26379,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "{{A1_IP}}/32"
                }
              }
            ],
            "ports": [
              {
                "port": 26379,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "maimi-production"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "maimi.megmeet.com/component": "personal-cloud-manager"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "maimi-production-execution"
                  }
                },
                "podSelector": {
                  "matchLabels": {
                    "maimi.megmeet.com/component": "personal-cloud-manager"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 8092,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "maimi-production"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "maimi-production-execution"
                  }
                }
              }
            ],
            "ports": [
              {
                "port": 3084,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "{{SITE_GATEWAY_ENDPOINT_9}}/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "{{A1_IP}}/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "{{A2_IP}}/32"
                }
              },
              {
