              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "{{SITE_GATEWAY_ENDPOINT_4}}/32"
                }
              }
            ],
            "ports": [
              {
                "port": 443,
                "protocol": "TCP"
              }
            ]
          },
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "{{SITE_GATEWAY_ENDPOINT_4}}/32"
                }
              }
            ],
