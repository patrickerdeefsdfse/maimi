+  [Console]::Out.WriteLine(($value|ConvertTo-Json -Compress))
+  [Console]::Out.Flush()
+  $expectedSequence++
+ } catch {
+  [Console]::Out.WriteLine('{"schema":1,"failure":"PROBE_FAILED"}')
