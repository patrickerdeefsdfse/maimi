ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}
WORKDIR /app
# Bootstrap from the Gateway requirements once; subsequent builds consume the
# captured local full dependency lock and reject stale source requirements.
COPY services/gateway/requirements.txt /app/requirements.txt
COPY dev-local/install_dependencies.py /app/install_dependencies.py
COPY dev-local/locks/ /app/build-locks/
RUN python /app/install_dependencies.py --source /app/requirements.txt --locks /app/build-locks
COPY services/gateway/app /app/app
RUN mkdir -p /var/lib/megmeet/iam /var/lib/megmeet/files && chown 10001:10001 /var/lib/megmeet/iam /var/lib/megmeet/files
USER 10001:10001
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
